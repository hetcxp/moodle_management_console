# Frontend & API Configuration
VITE_MOODLE_URL=https://your-moodle-instance.com
VITE_SERVICE_NAME=tool_management_console
VITE_TENANT=default

# Automation & E2E Testing Scripts Configuration
# Explicit target URL (mandatory for operational scripts)
MOODLE_URL=https://your-moodle-instance.com
MOODLE_USER=admin
MOODLE_PASS=your_secure_password
MOODLE_TOKEN=your_moodle_webservice_token

# Safety Confirmation Flag (Required to execute mutating remote actions)
CONFIRM_TARGET=0

# Executable Binary Overrides (optional, auto-discovered if unset)
# CHROME_BIN=/usr/bin/google-chrome
# PHP_BIN=/usr/bin/php
